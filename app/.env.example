# Copy to .env.local for local development. Never commit real values.

# Sign-in sessions. Any random string of 32+ characters. Required in production.
BETTER_AUTH_SECRET=
# The public address of the app. Local: http://localhost:3000. On Vercel it defaults to the project's public address.
# Set production to https://lifepark.cohegen.net only after the domain is attached
# and HTTPS works. Register Google/Apple callback URLs for that origin first.
BETTER_AUTH_URL=http://localhost:3000

# Postgres on Neon (through Vercel). Leave empty locally to use the built-in PGlite database.
DATABASE_URL=

# Sign-in providers. A provider's button appears only when both of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple needs four values from the Apple Developer account instead of a fixed secret.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# Models, added in step 1.5.
OPENROUTER_API_KEY=
# Optional: the one AI model behind LifePark, as an OpenRouter id. Defaults to the value in src/lib/chat/model.ts.
LIFEPARK_MODEL=

# Read-aloud voice, added in step 1.8. Without it the device's own voice is used.
SPEECHIFY_API_KEY=
# Optional: a Speechify voice id (default geffen_32). See https://docs.speechify.ai/build/text-to-speech-api
SPEECHIFY_VOICE_ID=

# Tests only: point the app at a local stand-in for OpenRouter.
OPENROUTER_BASE_URL=
# Tests only: point Google imports at a local stand-in (see e2e/mock-google.mjs).
GOOGLE_API_BASE=

# GitHub App (repositories in the Workshop). All four from the app's settings page on GitHub.
# The app's short name, from its address github.com/apps/<slug>.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The whole private key file (.pem) the app's settings page downloads.
GITHUB_APP_PRIVATE_KEY=
# Tests only: point GitHub at a local stand-in (see e2e/mock-github.mjs).
GITHUB_API_BASE=
GITHUB_WEB_BASE=

# Owner dashboard (/owner): comma-separated emails of the people who run LifePark.
OWNER_EMAILS=
